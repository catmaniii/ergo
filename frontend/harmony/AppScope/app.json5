{
  "app": {
    // bundleName 自定（62 号票）。签名材料按 bundleName 生成：改了它要在 DevEco 里重新点一次"自动生成签名"
    // 二狗的鸿蒙 App 用的就是这个包名（2026-10-30 定）。在 AGC 建过应用之后别再改：改了就是另一个 App，手机上要卸载重装、数据会丢
    "bundleName": "com.catmaniii.ergo",
    "vendor": "ergo",
    "versionCode": 2001000,
    "versionName": "0.2.1",
    "icon": "$media:layered_image",
    "label": "$string:app_name"
  }
}
