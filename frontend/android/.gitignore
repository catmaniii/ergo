# 安卓工程的本机产物，不进仓库
/.gradle/
/build/
/app/build/
/.idea/
/.kotlin/
/local.properties
*.iml
*.log

# 签名：只在本机（docs/architecture/development.md 的"安卓 App"），放在哪里都不进仓库
/keystore.properties
*.jks
*.keystore

# 页面桥、App 原生的字：`npm run build:android` 从 packages/web、packages/protocol 收进来，不进仓库
/app/src/main/assets/page-bridge.js
/app/src/main/assets/harmony-texts.json

# 断电后 ~/.gradle 的锁文件坏了，也可以用独立的 GRADLE_USER_HOME 构建
/.gradle-home/
