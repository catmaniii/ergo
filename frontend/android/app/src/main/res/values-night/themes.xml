<?xml version="1.0" encoding="utf-8"?>
<!-- isLightTheme 要 API 29、windowLightNavigationBar 要 API 27：老系统不认识这两个属性会跳过，不用另开目录 -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Ergo" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:isLightTheme" tools:targetApi="29">false</item>
        <item name="android:windowBackground">@drawable/start_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
