<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 按住说话：原生录音（voice/NativeVoice.kt）。网页进语音模式、要备好录音器时才向用户申请 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 系统通知（notify/NativeNotify.kt）：本地通知，安卓 13 起要向用户申请。不接 FCM、不做前台服务 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 扫码连接：只在点"扫码连接"时才要；没有相机的设备照样能装，手填地址 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 在 App 里更新 App（update/AppUpdater.kt）：用系统的 PackageInstaller 装二狗发来的新版。第一次要用户在系统设置里允许"安装未知应用" -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 安卓 12 起 App 更新自己时，系统允许就不弹确认（setRequireUserAction）；目标 API 33 起要声明这个 -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ergo">

        <!-- 转屏、深浅色、键盘都不重建：WebView 里的页面要留着（对应鸿蒙 EntryAbility 是 singleton） -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 在 App 里更新 App：系统装的结果（会话 commit 时给的显式 PendingIntent，不导出） -->
        <receiver
            android:name=".update.InstallStatusReceiver"
            android:exported="false" />
        <!-- 装好了：系统发给新版的 MY_PACKAGE_REPLACED，App 里点"更新"装的才把 App 再打开 -->
        <receiver
            android:name=".update.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
