{
  "ports": {
    "local": 8810,
    "external": 8811
  },
  "media": {
    "maxUploadBytes": 209715200
  },
  "approvals": {
    "waitMinutes": 5
  },
  "models": {
    "deepseek/deepseek-flash": {
      "vision": false
    }
  },
  "materials": {
    "staleCardDays": 7
  },
  "publicAccess": {
    "vpsHost": "<VPS 的公网 IP>",
    "sshUser": "root",
    "sshKey": "<ssh 私钥的绝对路径>",
    "tunnelPort": 18811,
    "nginx": {
      "listen": "127.0.0.1:<前门转发到的本机端口，如 8443> ssl"
    }
  },
  "backup": {
    "time": "03:30",
    "syncDir": "<同步目录的绝对路径>"
  }
}
