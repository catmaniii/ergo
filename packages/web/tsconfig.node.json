{
  // 在 Node 里跑的部分：测试（前端状态层回放）和 Vite、vitest 的配置文件。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["test", "build", "vite.config.ts", "vitest.config.ts"],
  // 界面那一半的测试（缩放的数学，54 号票）、页面桥在真浏览器里的测试（134 号票）、网页插件的测试（193 号票）、
  // 设置四组的测试（247 号票：直接渲染 MorePage 的组件）要 DOM 的类型，另由 tsconfig.ui-test.json 查
  "exclude": ["test/ui", "test/page-bridge", "test/plugins", "test/pages"]
}
