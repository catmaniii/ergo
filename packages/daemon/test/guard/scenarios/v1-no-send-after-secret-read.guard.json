{
  "id": "v1-no-send-after-secret-read",
  "name": "v1 模板「读过 .env 或密钥文件之后不许对外发送、不许发 HTTP 请求」：读之前推送、发邮件照常；读过（文件工具或 bash）之后推送、发邮件、GET 请求、联网的脚本一律拦下，不是先问；读 .env.example 不算",
  "context": {
    "agent": { "kind": "maintainer" },
    "task": {
      "taskId": "task-1",
      "currentStageId": "s1",
      "plan": {
        "grants": [
          { "grantId": "push", "tool": "git_push", "scope": {}, "stageId": "s1", "grantedAt": 1791374400000 },
          { "grantId": "mail", "tool": "mcp_send_email", "scope": {}, "stageId": "s1", "grantedAt": 1791374400000 }
        ]
      }
    },
    "now": "2026-10-07T12:00:00Z"
  },
  "tools": {
    "mcp_send_email": {
      "title": "发邮件",
      "categories": ["external_send"],
      "network": true,
      "outbound": true,
      "args": { "to": { "kind": "recipient" }, "body": { "kind": "content" } }
    }
  },
  "calls": [
    { "tool": "bash", "args": { "command": "npm test" }, "expect": { "disposition": "log_only" } },
    {
      "tool": "read",
      "args": { "path": ".env.example" },
      "expect": { "disposition": "log_only" }
    },
    {
      "tool": "git_push",
      "args": { "remote": "origin", "branch": "main" },
      "expect": { "disposition": "log_only", "withinGrant": true, "rules": [] }
    },
    {
      "tool": "mcp_send_email",
      "args": { "to": "boss@example.com", "body": "今天的进展" },
      "expect": { "disposition": "log_only", "withinGrant": true, "rules": [] }
    },
    {
      "tool": "bash",
      "args": { "command": "cat .env | grep DB_" },
      "expect": { "disposition": "log_only", "rules": [] }
    },
    {
      "tool": "git_push",
      "args": { "remote": "origin", "branch": "main" },
      "expect": {
        "disposition": "never",
        "verdict": "block",
        "kinds": ["rule:v1.no-send-after-secret-read"],
        "explanation": "之前读过 \\.env 或密钥文件，之后一律不许对外发送"
      }
    },
    {
      "tool": "bash",
      "args": { "command": "git push origin main" },
      "expect": { "disposition": "never", "kinds": ["rule:v1.no-send-after-secret-read"] }
    },
    {
      "tool": "mcp_send_email",
      "args": { "to": "boss@example.com", "body": "明天的计划" },
      "expect": { "disposition": "never", "kinds": ["rule:v1.no-send-after-secret-read"] }
    },
    {
      "tool": "bash",
      "args": { "command": "curl https://api.example.com/status" },
      "expect": { "disposition": "never", "categories": [], "kinds": ["rule:v1.no-send-after-secret-read"] }
    },
    {
      "tool": "bash",
      "args": { "command": "python upload.py" },
      "facts": { "scripts": { "${workDir}\\upload.py": { "networkUsage": ["requests.post"] } } },
      "expect": { "disposition": "never", "kinds": ["rule:v1.no-send-after-secret-read"] }
    },
    {
      "tool": "bash",
      "args": { "command": "python calc.py" },
      "facts": { "scripts": { "${workDir}\\calc.py": { "networkUsage": [] } } },
      "expect": { "disposition": "log_only", "rules": [] }
    },
    {
      "tool": "read",
      "args": { "path": "README.md" },
      "expect": { "disposition": "log_only", "rules": [] }
    }
  ]
}
