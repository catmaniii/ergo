{
  "id": "v1-secretary-scratch-exempt",
  "name": "v1 模板只管项目档案和工作目录：秘书在草稿区里删除、覆盖没提交过的文件（草稿区不是 git 仓库）仍为直接做只记录；草稿区里的 rm -rf 也不算项目外",
  "context": {
    "agent": { "kind": "secretary" },
    "task": null
  },
  "calls": [
    {
      "tool": "write",
      "args": { "path": "report.md", "content": "第一版" },
      "facts": { "files": { "${scratch}\\report.md": { "exists": false } } },
      "expect": { "disposition": "log_only", "rules": [] }
    },
    {
      "tool": "write",
      "args": { "path": "report.md", "content": "整篇重写" },
      "facts": {
        "files": { "${scratch}\\report.md": { "exists": true } },
        "git": { "${scratch}": { "uncommittedPaths": [], "repository": false } }
      },
      "expect": { "disposition": "log_only", "categories": [], "rules": [] }
    },
    {
      "tool": "bash",
      "args": { "command": "rm report.md" },
      "expect": { "disposition": "log_only", "categories": [], "rules": [], "genericShell": true }
    },
    {
      "tool": "bash",
      "args": { "command": "mkdir -p tmp/run1 && rm -rf tmp" },
      "expect": { "disposition": "log_only", "rules": [] }
    },
    {
      "tool": "bash",
      "args": { "command": "rm -rf ~/Downloads/old" },
      "expect": { "disposition": "never", "categories": ["outside_project"], "kinds": ["rule:v1.no-force-push-or-rm-rf-outside"] }
    }
  ]
}
