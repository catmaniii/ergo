{
  "id": "planguard-storage",
  "name": "planguard 的 storage 场景（storage.planguard.json 的 tools 和 rules 原样，用例是 storage/runtime.json）：删重要文件前必须备份、删除前必须扫描过目录。和原版的差别：二狗没有计划一致性检查（forbidden、out_of_order、out_of_scope 不比），$step 不存在（S1 的 unless 不成立）；只在规划时检查的 S3 没搬。on_violation 不写时和 planguard 一样先问",
  "context": {
    "agent": { "kind": "maintainer" },
    "task": null
  },
  "tools": {
    "file_delete": { "args": { "scope": { "pattern": "^/" }, "path": { "pattern": "^/" }, "count": { "type": "number" } } },
    "storage_scan": { "args": { "prefix": { "pattern": "^/" } } },
    "cloud_backup": { "args": { "path": { "pattern": "^/" } } },
    "storage_usage": {}
  },
  "rules": [
    {
      "id": "S1",
      "title": "删除重要文件前必须先备份",
      "trigger": { "tool": "file_delete" },
      "for_each": {
        "var": "f",
        "key": "$f.path",
        "in": {
          "select": {
            "from": "$facts.files",
            "where": {
              "and": [
                { "eq": ["$row.important", true] },
                { "ne": ["$row.backedUp", true] },
                { "or": [{ "startswith": ["$row.path", "$current.args.scope"] }, { "eq": ["$row.path", "$current.args.path"] }] }
              ]
            }
          }
        }
      },
      "unless": { "in": ["$f.path", { "as_list": "$step.args.exclude" }] },
      "require": { "before": { "tool": "cloud_backup", "where": { "eq": ["$prior.args.path", "$f.path"] } } },
      "message": "「{f.path}」被标为重要且没有备份，删除前必须先备份",
      "on_violation": "block",
      "repairs": [
        { "insert": { "tool": "cloud_backup", "title": "先把 {f.path} 备份到云端", "args": { "path": "$f.path" }, "share": "$f.path" }, "cost": { "disclosure": 1, "interaction": 1 } },
        { "rewrite": { "append": { "exclude": "$f.path" }, "title": "从删除范围中剔除 {f.path}" } }
      ]
    },
    {
      "id": "S2",
      "title": "删除前必须先扫描过该目录",
      "trigger": { "tool": "file_delete" },
      "when": { "or": [{ "present": "$current.args.scope" }, { "present": "$current.args.path" }] },
      "require": {
        "before": {
          "tool": "storage_scan",
          "where": { "startswith": [{ "if": [{ "present": "$current.args.scope" }, "$current.args.scope", "$current.args.path"] }, "$prior.args.prefix"] }
        }
      },
      "message": "步骤 {current.id} 删除文件之前没有扫描过对应目录",
      "repairs": [{ "insert": { "tool": "storage_scan", "title": "扫描 {current.args.scope}", "args": { "prefix": "$current.args.scope" }, "share": "$current.args.scope" } }]
    }
  ],
  "facts": {
    "files": {
      "/DCIM/Screenshots/Screenshot_2026-08-01_100000.png": { "exists": true, "sizeMB": 2.1, "lastOpened": "2026-08-01", "kind": "screenshot" },
      "/Recordings/2026-08-03 周会.m4a": { "exists": true, "sizeMB": 48, "lastOpened": "2026-08-03", "kind": "recording" },
      "/Recordings/2026-08-22 星联科技签约会谈.m4a": { "exists": true, "sizeMB": 132, "lastOpened": "2026-08-22", "kind": "recording", "important": true },
      "/DCIM/Camera/VID_20260815_运动会.mp4": { "exists": true, "sizeMB": 1240, "lastOpened": "2026-08-15", "kind": "video", "important": true },
      "/Documents/星联科技采购合同-已签章.pdf": { "exists": true, "sizeMB": 12, "lastOpened": "2026-09-05", "kind": "document", "important": true, "backedUp": true },
      "/Documents/报销单模板.xlsx": { "exists": true, "sizeMB": 0.3, "lastOpened": "2026-05-11", "kind": "document" }
    }
  },
  "calls": [
    { "tool": "storage_usage", "args": {}, "expect": { "verdict": "allow", "kinds": [] } },
    { "tool": "storage_scan", "args": { "prefix": "/DCIM/Screenshots/" }, "expect": { "verdict": "allow", "kinds": [] } },
    { "tool": "file_delete", "args": { "path": "/DCIM/Screenshots/Screenshot_2026-08-01_100000.png" }, "expect": { "verdict": "allow", "kinds": [] } },
    {
      "tool": "file_delete",
      "args": { "path": "/Recordings/2026-08-22 星联科技签约会谈.m4a" },
      "expect": { "verdict": "block", "kinds": ["rule:S1", "rule:S2"], "explanation": "被标为重要且没有备份" }
    },
    { "tool": "storage_scan", "args": { "prefix": "/Recordings/" }, "expect": { "verdict": "allow", "kinds": [] } },
    { "tool": "file_delete", "args": { "path": "/Recordings/2026-08-03 周会.m4a" }, "expect": { "verdict": "allow", "kinds": [] } },
    { "tool": "file_delete", "args": { "path": "/DCIM/Camera/VID_20260815_运动会.mp4" }, "expect": { "verdict": "block", "kinds": ["rule:S1", "rule:S2"] } },
    { "tool": "storage_scan", "args": { "prefix": "/DCIM/Camera/" }, "expect": { "verdict": "allow", "kinds": [] } },
    { "tool": "cloud_backup", "args": { "path": "/DCIM/Camera/VID_20260815_运动会.mp4" }, "expect": { "verdict": "allow", "kinds": [] } },
    { "tool": "file_delete", "args": { "path": "/DCIM/Camera/VID_20260815_运动会.mp4" }, "expect": { "verdict": "allow", "kinds": [] } },
    { "tool": "file_delete", "args": { "path": "/Documents/星联科技采购合同-已签章.pdf" }, "commit": false, "expect": { "verdict": "confirm", "kinds": ["rule:S2"] } },
    { "tool": "file_delete", "args": { "path": "/Documents/报销单模板.xlsx" }, "commit": false, "expect": { "verdict": "confirm", "kinds": ["rule:S2"] } },
    { "tool": "storage_scan", "args": { "prefix": "/Documents/" }, "expect": { "verdict": "allow", "kinds": [] } },
    { "tool": "file_delete", "args": { "path": "/Documents/星联科技采购合同-已签章.pdf" }, "expect": { "verdict": "allow", "kinds": [] } },
    { "tool": "file_delete", "args": { "path": "/Documents/新文件.txt", "count": "三个" }, "expect": { "verdict": "allow", "kinds": [] } },
    { "tool": "file_delete", "args": { "path": "Documents/相对路径.txt" }, "expect": { "verdict": "confirm", "kinds": ["rule_unknown:S1", "rule_unknown:S2"], "explanation": "判断不了" } }
  ]
}
